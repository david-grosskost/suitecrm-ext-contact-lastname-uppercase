{
    "name": "david-grosskost/suitecrm-ext-contact-lastname-uppercase",
    "description": "Nom de famille des contacts SuiteCRM toujours en majuscules, y compris pour les contacts déjà présents.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.29"
    },
    "autoload-dev": {
        "psr-4": {
            "SuiteCrmExt\\ContactLastnameUppercase\\": "legacy/include/contact-lastname-uppercase/",
            "SuiteCrmExt\\ContactLastnameUppercase\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
